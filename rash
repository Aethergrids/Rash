#!/bin/zsh

set -eu
setopt pipe_fail

typeset -gr SCRIPT_PATH="${0:A}"
typeset -gr PROJECT_ROOT="${SCRIPT_PATH:h}"
typeset -gr STATE_DIR="${RASH_STATE_DIR:-${PROJECT_ROOT}/.rash}"
typeset -gr STATE_FILE="${STATE_DIR}/state"
typeset -gr SECRET_FILE="${STATE_DIR}/controller-secret"
typeset -gr SYSTEM_PROXY_STATE_FILE="${STATE_DIR}/system-proxy-state"
typeset -gr USER_SOCKET="${STATE_DIR}/tmux.sock"
typeset -gr SESSION_NAME="rash"
typeset -gr SESSION_RUNNER="${PROJECT_ROOT}/scripts/rash-session.zsh"
typeset -gr YACD_DIR="${PROJECT_ROOT}/assets/yacd-meta"
typeset -gr COUNTRY_MMDB="${PROJECT_ROOT}/assets/geoip/Country.mmdb"
typeset -gr UI_URL="http://127.0.0.1:9090/ui/"
typeset -gr API_URL="http://127.0.0.1:9090"

typeset default_clash_bin
if [[ -x "${PROJECT_ROOT}/bin/clash" ]]; then
  default_clash_bin="${PROJECT_ROOT}/bin/clash"
else
  default_clash_bin="${commands[clash]:-${PROJECT_ROOT}/bin/clash}"
fi
typeset -gr CLASH_BIN="${CLASH_BIN:-$default_clash_bin}"
unset default_clash_bin
typeset -gr SING_BOX_BIN="${SING_BOX_BIN:-${commands[sing-box]:-}}"
typeset -gr TMUX_BIN="${TMUX_BIN:-${commands[tmux]:-}}"
typeset -gr YQ_BIN="${YQ_BIN:-${commands[yq]:-}}"
typeset -gr CURL_BIN="${CURL_BIN:-${commands[curl]:-/usr/bin/curl}}"
typeset -gr LSOF_BIN="${LSOF_BIN:-${commands[lsof]:-/usr/sbin/lsof}}"
typeset -gr OPENSSL_BIN="${OPENSSL_BIN:-${commands[openssl]:-/usr/bin/openssl}}"
typeset default_open_command="xdg-open"
[[ "$(uname -s)" == "Darwin" ]] && default_open_command="open"
typeset -gr OPEN_BIN="${OPEN_BIN:-${commands[$default_open_command]:-}}"
unset default_open_command
typeset -gr NETWORKSETUP_BIN="${NETWORKSETUP_BIN:-${commands[networksetup]:-/usr/sbin/networksetup}}"
typeset -gr SCUTIL_BIN="${SCUTIL_BIN:-${commands[scutil]:-/usr/sbin/scutil}}"

typeset ACTIVE_PROFILE=""
typeset ACTIVE_CLIENT=""
typeset PROXY_SERVICE=""
typeset PREVIOUS_HTTP_ENABLED=""
typeset PREVIOUS_HTTP_SERVER=""
typeset PREVIOUS_HTTP_PORT=""
typeset PREVIOUS_HTTPS_ENABLED=""
typeset PREVIOUS_HTTPS_SERVER=""
typeset PREVIOUS_HTTPS_PORT=""

usage() {
  cat <<'EOF'
Usage:
  rash start --config SG [--client clash-rs|sing-box] [--select] [--system-proxy]
  rash stop
  rash status
  rash select
  rash system-proxy on [--service NAME]
  rash system-proxy off
  rash system-proxy status
  rash attach
  rash logs
  rash ui
  rash env [--unset]
  rash exec [--] COMMAND [ARG ...]
  rash secret

Examples:
  rash start --config SG
  rash start --config SG --client sing-box
  rash start --config SG --select --system-proxy
  rash exec -- git pull
  eval "$(rash env)"

Detach from tmux without stopping the client: Ctrl-b, then d
EOF
}

die() {
  print -u2 -r -- "rash: $*"
  exit 1
}

require_executable() {
  local executable_path="$1"
  local label="$2"
  [[ -n "$executable_path" && -x "$executable_path" ]] || \
    die "$label is required but was not found"
}

ensure_dependencies() {
  local client="$1"
  require_executable "$(client_binary "$client")" "$client (run scripts/download-assets.zsh --only $client)"
  require_executable "$TMUX_BIN" "tmux"
  require_executable "$YQ_BIN" "yq v4"
  require_executable "$CURL_BIN" "curl"
  require_executable "$OPENSSL_BIN" "openssl"
  require_executable "$LSOF_BIN" "lsof"
  require_executable "$SESSION_RUNNER" "rash session runner"
  [[ -r "${YACD_DIR}/index.html" ]] || \
    die "Yacd-meta assets are missing; run scripts/download-assets.zsh --only yacd-meta"
  if [[ "$client" == "clash-rs" ]]; then
    [[ -r "$COUNTRY_MMDB" ]] || \
      die "GeoIP assets are missing; run scripts/download-assets.zsh --only geoip"
  fi
}

normalize_client() {
  case "$1" in
    clash-rs|sing-box) print -r -- "$1" ;;
    *) die "--client must be clash-rs or sing-box" ;;
  esac
}

client_binary() {
  case "$1" in
    clash-rs) print -r -- "$CLASH_BIN" ;;
    sing-box) print -r -- "$SING_BOX_BIN" ;;
  esac
}

config_filename() {
  case "$1" in
    clash-rs) print -r -- "config.yaml" ;;
    sing-box) print -r -- "sing-box.json" ;;
  esac
}

normalize_profile() {
  local profile="${1:u}"
  case "$profile" in
    SG) print -r -- "$profile" ;;
    *) die "--config must be SG" ;;
  esac
}

base_config_for() {
  print -r -- "${PROJECT_ROOT}/configs/$1/$(config_filename "$2")"
}

runtime_dir_for() {
  print -r -- "${STATE_DIR}/runtime/${1:l}-$2"
}

runtime_config_for() {
  print -r -- "$(runtime_dir_for "$1" "$2")/$(config_filename "$2")"
}

tmux_run() {
  "$TMUX_BIN" -S "$USER_SOCKET" "$@"
}

tmux_has_session() {
  tmux_run has-session -t "$SESSION_NAME" 2>/dev/null
}

read_state() {
  ACTIVE_PROFILE=""
  ACTIVE_CLIENT=""
  [[ -s "$STATE_FILE" ]] || return 1
  IFS=: read -r ACTIVE_PROFILE ACTIVE_CLIENT < "$STATE_FILE"
  [[ "$ACTIVE_PROFILE" == "SG" ]] || return 1
  [[ "$ACTIVE_CLIENT" == "clash-rs" || "$ACTIVE_CLIENT" == "sing-box" ]] || return 1
}

write_state() {
  print -r -- "$1:$2" >| "$STATE_FILE"
  chmod 600 "$STATE_FILE"
}

clear_state() {
  : >| "$STATE_FILE"
}

prepare_state_dir() {
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
}

prepare_secret() {
  [[ -s "$SECRET_FILE" ]] && return

  local temporary_secret
  temporary_secret="$(mktemp "${STATE_DIR}/controller-secret.XXXXXX")"
  "$OPENSSL_BIN" rand -hex 32 >| "$temporary_secret"
  chmod 600 "$temporary_secret"
  mv -f "$temporary_secret" "$SECRET_FILE"
}

proxy_field() {
  local settings="$1"
  local field="$2"
  local line

  while IFS= read -r line; do
    [[ "$line" == "${field}: "* ]] || continue
    print -r -- "${line#${field}: }"
    return 0
  done <<< "$settings"
  return 1
}

read_system_proxy_state() {
  [[ -s "$SYSTEM_PROXY_STATE_FILE" ]] || return 1
  IFS='|' read -r PROXY_SERVICE \
    PREVIOUS_HTTP_ENABLED PREVIOUS_HTTP_SERVER PREVIOUS_HTTP_PORT \
    PREVIOUS_HTTPS_ENABLED PREVIOUS_HTTPS_SERVER PREVIOUS_HTTPS_PORT \
    < "$SYSTEM_PROXY_STATE_FILE"
  [[ -n "$PROXY_SERVICE" && "$PREVIOUS_HTTP_PORT" == <-> && \
     "$PREVIOUS_HTTPS_PORT" == <-> ]] || die "invalid system proxy state"
  [[ "$PREVIOUS_HTTP_ENABLED" == "Yes" || "$PREVIOUS_HTTP_ENABLED" == "No" ]] || \
    die "invalid system proxy state"
  [[ "$PREVIOUS_HTTPS_ENABLED" == "Yes" || "$PREVIOUS_HTTPS_ENABLED" == "No" ]] || \
    die "invalid system proxy state"
}

save_system_proxy_state() {
  [[ "$PROXY_SERVICE" != *'|'* && "$PREVIOUS_HTTP_SERVER" != *'|'* && \
     "$PREVIOUS_HTTPS_SERVER" != *'|'* ]] || die "unsupported proxy state value"
  print -r -- "${PROXY_SERVICE}|${PREVIOUS_HTTP_ENABLED}|${PREVIOUS_HTTP_SERVER}|${PREVIOUS_HTTP_PORT}|${PREVIOUS_HTTPS_ENABLED}|${PREVIOUS_HTTPS_SERVER}|${PREVIOUS_HTTPS_PORT}" \
    >| "$SYSTEM_PROXY_STATE_FILE"
  chmod 600 "$SYSTEM_PROXY_STATE_FILE"
}

proxy_is_rash() {
  local http_settings
  local https_settings
  http_settings="$("$NETWORKSETUP_BIN" -getwebproxy "$1" 2>/dev/null)" || return 1
  https_settings="$("$NETWORKSETUP_BIN" -getsecurewebproxy "$1" 2>/dev/null)" || return 1
  [[ "$http_settings" == *$'Enabled: Yes\nServer: 127.0.0.1\nPort: 7890\n'* && \
     "$https_settings" == *$'Enabled: Yes\nServer: 127.0.0.1\nPort: 7890\n'* ]]
}

effective_proxy_port() {
  "$SCUTIL_BIN" --proxy | /usr/bin/awk '
    /__SCOPED__/ { exit }
    /HTTPEnable :/ { enabled = $3 }
    /HTTPProxy :/ { host = $3 }
    /HTTPPort :/ { port = $3 }
    END { if (enabled == 1 && host == "127.0.0.1") print port }
  '
}

restore_system_proxy() {
  local http_state="off"
  local https_state="off"
  [[ -n "$PREVIOUS_HTTP_SERVER" ]] && \
    "$NETWORKSETUP_BIN" -setwebproxy "$PROXY_SERVICE" \
      "$PREVIOUS_HTTP_SERVER" "$PREVIOUS_HTTP_PORT"
  [[ -n "$PREVIOUS_HTTPS_SERVER" ]] && \
    "$NETWORKSETUP_BIN" -setsecurewebproxy "$PROXY_SERVICE" \
      "$PREVIOUS_HTTPS_SERVER" "$PREVIOUS_HTTPS_PORT"
  [[ "$PREVIOUS_HTTP_ENABLED" == "Yes" ]] && http_state="on"
  [[ "$PREVIOUS_HTTPS_ENABLED" == "Yes" ]] && https_state="on"
  "$NETWORKSETUP_BIN" -setwebproxystate "$PROXY_SERVICE" "$http_state"
  "$NETWORKSETUP_BIN" -setsecurewebproxystate "$PROXY_SERVICE" "$https_state"
}

system_proxy_on() {
  local service="${RASH_NETWORK_SERVICE:-Wi-Fi}"
  local http_settings
  local https_settings

  if (( $# > 0 )); then
    [[ "$1" == "--service" && $# == 2 ]] || \
      die "usage: rash system-proxy on [--service NAME]"
    service="$2"
  fi
  require_active_session
  if read_system_proxy_state; then
    proxy_is_rash "$PROXY_SERVICE" || die "system proxy settings changed externally"
    print -r -- "Rash system proxy is already on for $PROXY_SERVICE."
    return 0
  fi

  http_settings="$("$NETWORKSETUP_BIN" -getwebproxy "$service")" || \
    die "unknown macOS network service: $service"
  https_settings="$("$NETWORKSETUP_BIN" -getsecurewebproxy "$service")"
  [[ "$(proxy_field "$http_settings" "Authenticated Proxy Enabled")" == "0" && \
     "$(proxy_field "$https_settings" "Authenticated Proxy Enabled")" == "0" ]] || \
    die "authenticated system proxies are not supported"

  PROXY_SERVICE="$service"
  PREVIOUS_HTTP_ENABLED="$(proxy_field "$http_settings" "Enabled")"
  PREVIOUS_HTTP_SERVER="$(proxy_field "$http_settings" "Server")"
  PREVIOUS_HTTP_PORT="$(proxy_field "$http_settings" "Port")"
  PREVIOUS_HTTPS_ENABLED="$(proxy_field "$https_settings" "Enabled")"
  PREVIOUS_HTTPS_SERVER="$(proxy_field "$https_settings" "Server")"
  PREVIOUS_HTTPS_PORT="$(proxy_field "$https_settings" "Port")"
  save_system_proxy_state

  if ! {
    "$NETWORKSETUP_BIN" -setwebproxy "$service" 127.0.0.1 7890
    "$NETWORKSETUP_BIN" -setsecurewebproxy "$service" 127.0.0.1 7890
    "$NETWORKSETUP_BIN" -setwebproxystate "$service" on
    "$NETWORKSETUP_BIN" -setsecurewebproxystate "$service" on
  }; then
    restore_system_proxy || true
    rm -f -- "$SYSTEM_PROXY_STATE_FILE"
    die "failed to enable the system proxy"
  fi

  print -r -- "Rash system proxy: on ($service, 127.0.0.1:7890)"
  [[ "$(effective_proxy_port)" == "7890" ]] || \
    print -u2 -r -- "rash: another VPN or network extension is overriding it"
}

system_proxy_off() {
  if ! read_system_proxy_state; then
    print -r -- "Rash system proxy is already off."
    return 0
  fi
  restore_system_proxy
  rm -f -- "$SYSTEM_PROXY_STATE_FILE"
  print -r -- "Rash system proxy: off (restored $PROXY_SERVICE)"
}

system_proxy_status() {
  local status_code=0

  if ! read_system_proxy_state; then
    print -r -- "Rash system proxy: off"
    status_code=1
  else
    proxy_is_rash "$PROXY_SERVICE" || die "system proxy settings changed externally"
    print -r -- "Rash system proxy: on ($PROXY_SERVICE, 127.0.0.1:7890)"
    [[ "$(effective_proxy_port)" == "7890" ]] || \
      print -r -- "Effective system proxy: overridden by another VPN or network extension"
  fi

  if read_state && tmux_has_session; then
    show_selector_status
  fi
  return "$status_code"
}

system_proxy_command() {
  local action="${1:-status}"
  (( $# > 0 )) && shift
  [[ "$(uname -s)" == "Darwin" ]] || die "system-proxy is only supported on macOS"
  require_executable "$NETWORKSETUP_BIN" "networksetup"
  require_executable "$SCUTIL_BIN" "scutil"
  case "$action" in
    on) system_proxy_on "$@" ;;
    off) (( $# == 0 )) || die "system-proxy off takes no options"; system_proxy_off ;;
    status) (( $# == 0 )) || die "system-proxy status takes no options"; system_proxy_status ;;
    *) die "system-proxy requires on, off, or status" ;;
  esac
}

render_runtime_config() {
  local profile="$1"
  local client="$2"
  local base_config
  local runtime_dir
  local runtime_config
  local temporary_config
  local yq_filter

  base_config="$(base_config_for "$profile" "$client")"
  runtime_dir="$(runtime_dir_for "$profile" "$client")"
  runtime_config="$(runtime_config_for "$profile" "$client")"

  [[ -r "$base_config" ]] || die "missing base config: $base_config"
  mkdir -p "$runtime_dir"
  chmod 700 "$runtime_dir"

  temporary_config="$(mktemp "${runtime_config}.XXXXXX")"

  if [[ "$client" == "sing-box" ]]; then
    RASH_SECRET_VALUE="$(<"$SECRET_FILE")" \
    RASH_UI_DIR="$YACD_DIR" \
      "$YQ_BIN" -p=json -o=json --from-file \
        "${PROJECT_ROOT}/scripts/sing-box-runtime.yq" "$base_config" >| "$temporary_config"
  else
    yq_filter='.mmdb = strenv(RASH_MMDB_PATH) |
    .["external-controller"] = "127.0.0.1:9090" |
    .["external-ui"] = strenv(RASH_UI_DIR) |
    del(.["external-ui-url"]) |
    .profile["store-selected"] = true |
    .secret = strenv(RASH_SECRET_VALUE) |
    del(.tun)'

    RASH_SECRET_VALUE="$(<"$SECRET_FILE")" \
    RASH_UI_DIR="$YACD_DIR" \
    RASH_MMDB_PATH="$COUNTRY_MMDB" \
      "$YQ_BIN" eval "$yq_filter" "$base_config" >| "$temporary_config"
  fi

  chmod 600 "$temporary_config"
  mv -f "$temporary_config" "$runtime_config"
  print -r -- "$runtime_config"
}

validate_runtime_config() {
  local runtime_config="$1"
  local client="$2"
  local runtime_dir="${runtime_config:h}"

  if [[ "$client" == "sing-box" ]]; then
    "$SING_BOX_BIN" check --directory "$runtime_dir" --config "$runtime_config"
  else
    "$CLASH_BIN" \
      --directory "$runtime_dir" \
      --config "$runtime_config" \
      --test-config \
      --strict-config
  fi
}

assert_ports_available() {
  local port
  for port in 7890 9090; do
    if "$LSOF_BIN" -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
      die "TCP port $port is already in use"
    fi
  done

  if "$LSOF_BIN" -nP -iUDP:1053 >/dev/null 2>&1; then
    die "UDP port 1053 is already in use"
  fi
}

capture_logs() {
  tmux_run capture-pane -p -J -t "${SESSION_NAME}:0.0" -S -200 2>/dev/null || true
}

wait_for_api() {
  local secret
  local attempt
  secret="$(<"$SECRET_FILE")"

  for attempt in {1..60}; do
    if "$CURL_BIN" --fail --silent --show-error \
      --connect-timeout 1 --max-time 2 \
      --header "Authorization: Bearer ${secret}" \
      "${API_URL}/version" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done

  print -u2 -r -- "rash: client did not expose its controller within 30 seconds"
  capture_logs >&2
  return 1
}

wait_for_ui() {
  local attempt
  for attempt in {1..30}; do
    if "$CURL_BIN" --fail --silent --output /dev/null \
      --connect-timeout 1 --max-time 2 "$UI_URL"; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

controller_get() {
  local endpoint="$1"
  local secret
  secret="$(<"$SECRET_FILE")"
  "$CURL_BIN" --fail --silent --show-error \
    --header "Authorization: Bearer ${secret}" \
    "${API_URL}${endpoint}"
}

url_encode() {
  RASH_URI_VALUE="$1" "$YQ_BIN" -n -r 'strenv(RASH_URI_VALUE) | @uri' | \
    /usr/bin/sed 's/+/\%20/g'
}

selector_rows() {
  local proxies_json="$1"
  print -r -- "$proxies_json" | "$YQ_BIN" -p=json -r '
    .proxies | to_entries[] |
    select(.value.type == "Selector" and .key != "GLOBAL") |
    [.key, .value.now] | @tsv
  '
}

show_selector_status() {
  local proxies_json
  local rows
  local selector_name
  local selected_name

  if ! proxies_json="$(controller_get /proxies 2>/dev/null)"; then
    print -r -- "Connection: controller unavailable"
    return 0
  fi
  rows="$(selector_rows "$proxies_json")"
  if [[ -z "$rows" ]]; then
    print -r -- "Connection: no configured Selector group"
    return 0
  fi

  while IFS=$'\t' read -r selector_name selected_name; do
    print -r -- "Connection: ${selector_name} -> ${selected_name}"
  done <<< "$rows"
}

measure_proxy_delay() {
  local proxy_name="$1"
  local encoded_name
  local response
  local response_body
  local status_code
  local delay

  encoded_name="$(url_encode "$proxy_name")"
  response="$("$CURL_BIN" --silent --show-error --get \
    --header "Authorization: Bearer $(<"$SECRET_FILE")" \
    --data-urlencode 'url=https://www.gstatic.com/generate_204' \
    --data-urlencode 'timeout=5000' \
    --max-time 8 \
    --write-out $'\n%{http_code}' \
    "${API_URL}/proxies/${encoded_name}/delay" 2>/dev/null || true)"
  status_code="${response##*$'\n'}"
  response_body="${response%$'\n'*}"

  if [[ "$status_code" == "200" ]]; then
    delay="$(print -r -- "$response_body" | "$YQ_BIN" -p=json -r '.delay // 0')"
    if [[ "$delay" == <-> && "$delay" -gt 0 ]]; then
      print -r -- "${delay} ms"
      return 0
    fi
  fi
  print -r -- "timeout"
}

choose_index() {
  local prompt="$1"
  local default_index="$2"
  local maximum="$3"
  local choice

  print -u2 -n -r -- "${prompt} [${default_index}]: "
  IFS= read -r choice
  [[ -n "$choice" ]] || choice="$default_index"
  [[ "$choice" == <-> && "$choice" -ge 1 && "$choice" -le "$maximum" ]] || \
    die "selection must be a number from 1 to ${maximum}"
  print -r -- "$choice"
}

proxy_member_detail() {
  local proxy_name="$1"
  local proxies_json="$2"
  local proxy_type
  local server
  local server_kind=""
  local runtime_config

  proxy_type="$(PROXY_NAME="$proxy_name" print -r -- "$proxies_json" | \
    PROXY_NAME="$proxy_name" "$YQ_BIN" -p=json -r \
      '.proxies[strenv(PROXY_NAME)].type // "unknown"')"
  runtime_config="$(runtime_config_for "$ACTIVE_PROFILE" "$ACTIVE_CLIENT")"
  if [[ -r "$runtime_config" ]]; then
    if [[ "$ACTIVE_CLIENT" == "sing-box" ]]; then
      server="$(PROXY_NAME="$proxy_name" "$YQ_BIN" -p=json -o=yaml -r \
        '.outbounds[] | select(.tag == strenv(PROXY_NAME)) | .server // ""' \
        "$runtime_config")"
    else
      server="$(PROXY_NAME="$proxy_name" "$YQ_BIN" -r \
        '.proxies[] | select(.name == strenv(PROXY_NAME)) | .server // ""' \
        "$runtime_config")"
    fi
  fi
  if [[ -n "$server" ]]; then
    if [[ "$server" == *:* ]]; then
      server_kind="IPv6"
    elif [[ "$server" =~ '^[0-9.]+$' ]]; then
      server_kind="IPv4"
    else
      server_kind="hostname"
    fi
  fi

  if [[ -n "$server_kind" ]]; then
    print -r -- "${proxy_type}, ${server_kind}"
  else
    print -r -- "$proxy_type"
  fi
}

select_proxy_interactive() {
  local proxies_json
  local rows
  local selector_name
  local selected_name
  local choice
  local index
  local default_index=1
  local member_name
  local encoded_selector
  local request_body
  local confirmed_name
  local result_file
  local -a selector_names
  local -a selector_currents
  local -a members
  local -a delays
  local -a details
  local -a result_files
  local -a delay_pids

  require_active_session
  [[ -t 0 ]] || die "select requires an interactive terminal"
  proxies_json="$(controller_get /proxies)"
  rows="$(selector_rows "$proxies_json")"
  [[ -n "$rows" ]] || die "no configured Selector group was found"

  while IFS=$'\t' read -r selector_name selected_name; do
    selector_names+=("$selector_name")
    selector_currents+=("$selected_name")
  done <<< "$rows"

  if (( ${#selector_names} > 1 )); then
    print -r -- "Selector groups:"
    for (( index = 1; index <= ${#selector_names}; index++ )); do
      printf '  %d) %s -> %s\n' "$index" "${selector_names[$index]}" \
        "${selector_currents[$index]}"
    done
    choice="$(choose_index "Choose Selector" 1 "${#selector_names}")"
  else
    choice=1
  fi
  selector_name="${selector_names[$choice]}"
  selected_name="${selector_currents[$choice]}"
  members=("${(@f)$(SELECTOR_NAME="$selector_name" print -r -- "$proxies_json" | \
    SELECTOR_NAME="$selector_name" "$YQ_BIN" -p=json -r \
      '.proxies[strenv(SELECTOR_NAME)].all[]')}")
  (( ${#members} > 0 )) || die "Selector ${selector_name} has no members"

  for (( index = 1; index <= ${#members}; index++ )); do
    [[ "${members[$index]}" == "$selected_name" ]] && default_index="$index"
    details+=("$(proxy_member_detail "${members[$index]}" "$proxies_json")")
    result_file="$(mktemp "${STATE_DIR}/delay.XXXXXX")"
    result_files+=("$result_file")
    measure_proxy_delay "${members[$index]}" >| "$result_file" &
    delay_pids+=($!)
  done
  print -r -- "Testing ${selector_name} latency..."
  for (( index = 1; index <= ${#delay_pids}; index++ )); do
    wait "${delay_pids[$index]}" || true
    delays+=("$(<"${result_files[$index]}")")
    rm -f -- "${result_files[$index]}"
  done

  print -r -- "${selector_name} members (default/current: ${selected_name}):"
  for (( index = 1; index <= ${#members}; index++ )); do
    member_name="${members[$index]}"
    if (( index == default_index )); then
      printf '  %d) %-24s %-18s %8s  [default/current]\n' \
        "$index" "$member_name" "${details[$index]}" "${delays[$index]}"
    else
      printf '  %d) %-24s %-18s %8s\n' \
        "$index" "$member_name" "${details[$index]}" "${delays[$index]}"
    fi
  done
  choice="$(choose_index "Choose proxy" "$default_index" "${#members}")"
  member_name="${members[$choice]}"
  encoded_selector="$(url_encode "$selector_name")"
  request_body="$(RASH_SELECTED_PROXY="$member_name" "$YQ_BIN" -n -o=json \
    '{"name": strenv(RASH_SELECTED_PROXY)}')"
  "$CURL_BIN" --fail --silent --show-error --request PUT \
    --header "Authorization: Bearer $(<"$SECRET_FILE")" \
    --header 'Content-Type: application/json' \
    --data "$request_body" \
    "${API_URL}/proxies/${encoded_selector}" >/dev/null
  confirmed_name="$(SELECTOR_NAME="$selector_name" controller_get /proxies | \
    SELECTOR_NAME="$selector_name" "$YQ_BIN" -p=json -r \
      '.proxies[strenv(SELECTOR_NAME)].now')"
  [[ "$confirmed_name" == "$member_name" ]] || die "Controller did not apply the selection"
  print -r -- "Selected: ${selector_name} -> ${confirmed_name}"
}

start_service() {
  local profile=""
  local client="clash-rs"
  local prompt_for_selector="false"
  local enable_system_proxy="false"
  local runtime_config
  local runtime_dir
  local command_line

  while (( $# > 0 )); do
    case "$1" in
      --config|-c)
        (( $# >= 2 )) || die "$1 requires SG"
        profile="$(normalize_profile "$2")"
        shift 2
        ;;
      --config=*)
        profile="$(normalize_profile "${1#*=}")"
        shift
        ;;
      --client)
        (( $# >= 2 )) || die "--client requires clash-rs or sing-box"
        client="$(normalize_client "$2")"
        shift 2
        ;;
      --client=*)
        client="$(normalize_client "${1#*=}")"
        shift
        ;;
      --select)
        prompt_for_selector="true"
        shift
        ;;
      --system-proxy)
        enable_system_proxy="true"
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *) die "unknown start option: $1" ;;
    esac
  done

  [[ -n "$profile" ]] || die "start requires --config SG"
  [[ "$prompt_for_selector" != "true" || -t 0 ]] || \
    die "--select requires an interactive terminal"
  [[ "$enable_system_proxy" != "true" || "$(uname -s)" == "Darwin" ]] || \
    die "--system-proxy is only supported on macOS"
  ensure_dependencies "$client"
  prepare_state_dir
  prepare_secret

  if read_state && tmux_has_session; then
    die "$ACTIVE_PROFILE is already running; run 'rash stop' first"
  fi

  assert_ports_available
  runtime_config="$(render_runtime_config "$profile" "$client")"
  runtime_dir="${runtime_config:h}"

  print -r -- "Validating ${profile} configuration..."
  validate_runtime_config "$runtime_config" "$client"

  local client_bin="$(client_binary "$client")"
  command_line="${(q)SESSION_RUNNER} ${(q)client} ${(q)client_bin} ${(q)runtime_dir} ${(q)runtime_config}"
  tmux_run new-session -d \
    -s "$SESSION_NAME" \
    -n "$client" \
    -c "$runtime_dir" \
    "$command_line"
  write_state "$profile" "$client"

  if ! wait_for_api; then
    print -u2 -r -- "Use 'rash attach' to inspect the preserved tmux session."
    return 1
  fi
  print -r -- "Rash started: profile=$profile client=$client"
  print -r -- "Proxy: http://127.0.0.1:7890  (HTTP + SOCKS5)"
  print -r -- "Yacd:  $UI_URL"
  print -r -- "Tmux:  rash attach"

  if ! wait_for_ui; then
    print -u2 -r -- "Yacd is not responding; run 'rash logs' or retry the UI shortly."
  fi

  if [[ "$prompt_for_selector" == "true" ]]; then
    select_proxy_interactive
  else
    show_selector_status
  fi

  if [[ "$enable_system_proxy" == "true" ]] && ! (system_proxy_command on); then
    print -u2 -r -- "rash: system proxy setup failed; stopping client"
    stop_service || true
    return 1
  fi
}

stop_service() {
  local attempt

  prepare_state_dir
  [[ -s "$SYSTEM_PROXY_STATE_FILE" ]] && system_proxy_off
  if ! read_state; then
    print -r -- "Rash is not running."
    return 0
  fi

  if ! tmux_has_session; then
    clear_state
    print -r -- "Rash is already stopped."
    return 0
  fi

  print -r -- "Stopping $ACTIVE_PROFILE..."
  tmux_run send-keys -t "${SESSION_NAME}:0.0" C-c

  for attempt in {1..40}; do
    tmux_has_session || break
    sleep 0.25
  done

  if tmux_has_session; then
    print -u2 -r -- "rash: graceful shutdown timed out; closing the tmux session"
    tmux_run kill-session -t "$SESSION_NAME"
  fi

  clear_state
  print -r -- "Rash stopped."
}

status_service() {
  prepare_state_dir
  if ! read_state || ! tmux_has_session; then
    print -r -- "Rash: stopped"
    return 1
  fi

  print -r -- "Rash: running"
  print -r -- "Profile:  $ACTIVE_PROFILE"
  print -r -- "Client:   $ACTIVE_CLIENT"
  print -r -- "Proxy:    http://127.0.0.1:7890"
  print -r -- "Yacd:     $UI_URL"
  print -r -- "Session:  $SESSION_NAME"
  show_selector_status
}

require_active_session() {
  prepare_state_dir
  read_state || die "Rash is not running"
  tmux_has_session || die "the recorded tmux session is no longer running"
}

attach_service() {
  require_active_session
  exec "$TMUX_BIN" -S "$USER_SOCKET" attach-session -t "$SESSION_NAME"
}

show_logs() {
  require_active_session
  capture_logs
}

open_ui() {
  require_active_session
  require_executable "$OPEN_BIN" "browser opener (open on macOS, xdg-open on Linux)"
  "$OPEN_BIN" "$UI_URL"
  print -r -- "If Yacd asks for the API secret, run: rash secret"
}

proxy_environment() {
  if [[ "${1:-}" == "--unset" ]]; then
    (( $# == 1 )) || die "usage: rash env [--unset]"
    print -r -- "unset HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY"
    print -r -- "unset http_proxy https_proxy all_proxy no_proxy"
    return 0
  fi
  (( $# == 0 )) || die "usage: rash env [--unset]"
  require_active_session
  print -r -- "export HTTP_PROXY=http://127.0.0.1:7890"
  print -r -- "export HTTPS_PROXY=http://127.0.0.1:7890"
  print -r -- "export ALL_PROXY=socks5h://127.0.0.1:7890"
  print -r -- "export NO_PROXY=localhost,127.0.0.1,::1"
  print -r -- "export http_proxy=\$HTTP_PROXY"
  print -r -- "export https_proxy=\$HTTPS_PROXY"
  print -r -- "export all_proxy=\$ALL_PROXY"
  print -r -- "export no_proxy=\$NO_PROXY"
}

proxy_exec() {
  require_active_session
  if [[ "${1:-}" == "--" ]]; then
    shift
  fi
  (( $# > 0 )) || die "usage: rash exec [--] COMMAND [ARG ...]"
  exec /usr/bin/env \
    HTTP_PROXY=http://127.0.0.1:7890 \
    HTTPS_PROXY=http://127.0.0.1:7890 \
    ALL_PROXY=socks5h://127.0.0.1:7890 \
    NO_PROXY=localhost,127.0.0.1,::1 \
    http_proxy=http://127.0.0.1:7890 \
    https_proxy=http://127.0.0.1:7890 \
    all_proxy=socks5h://127.0.0.1:7890 \
    no_proxy=localhost,127.0.0.1,::1 \
    "$@"
}

show_secret() {
  prepare_state_dir
  prepare_secret
  print -r -- "$(<"$SECRET_FILE")"
}

main() {
  local command="${1:-help}"
  (( $# > 0 )) && shift

  case "$(uname -s)" in
    Darwin|Linux) ;;
    *) die "only macOS and Linux are supported" ;;
  esac

  case "$command" in
    start) start_service "$@" ;;
    stop) stop_service "$@" ;;
    status) status_service "$@" ;;
    select) (( $# == 0 )) || die "select takes no options"; select_proxy_interactive ;;
    system-proxy) system_proxy_command "$@" ;;
    attach) attach_service "$@" ;;
    logs) show_logs "$@" ;;
    ui) open_ui "$@" ;;
    env) proxy_environment "$@" ;;
    exec) proxy_exec "$@" ;;
    secret) show_secret "$@" ;;
    help|-h|--help) usage ;;
    *) die "unknown command: $command (run 'rash help')" ;;
  esac
}

main "$@"
